    {
      "id": "hard-coded-idd-instruction-file-count",
      "glob": "**/*.md",
      "pattern": "\\b(thirteen|13)\\s+`?idd-\\*\\.instructions\\.md`?\\s+files\\b",
      "message": "Avoid hard-coded IDD instruction file counts. Use a generated block or count-free wording."
    }
  ],
  "rootMarkdownAllowlist": {
    "id": "root-markdown-allowlist",
    "allowed": [
      "AGENTS.md",
      "CHANGELOG.md",
      "CLAUDE.md",
      "GEMINI.md",
      "README.ja.md",
      "README.md",
      "SECURITY.md"
    ]
  },
  "typeSuppressionBudgets": {
    "id": "type-suppression-budgets",
    "description": "Ratchet rule: raising a limit requires an explicit callout in the PR description; lowering is always allowed. The ts-ignore directive is forbidden outright; ts-expect-error is the only allowed escape and must carry a same-line reason. These ts-suppression limits (ts-expect-error / explicit-any) record the measured current counts, not aspirations. The separate bundleBudgets instead carry a small headroom (at most roughly 10% over the measured total, never an exact fit) so a concurrent budget bump does not collide; see audit/README.md and docs/policy-constants.md.",
    "globs": [
      "src/**/*.mts",
      "tests/**/*.mts"
    ],
    "tsExpectErrorLimit": 0,
    "explicitAnyLimit": 0
  },
  "okfBundles": [
    {
      "id": "docs-okf",
      "_comment": "OKF (Open Knowledge Format v0.1) frontmatter conformance bundle (#1680). Fail-closed: every .md file under roots/**/*.md is checked unless its basename is in reservedFilenames or its path is in exemptPaths. No page is backfilled by this track -- exemptPaths lists every page that predates the profile; a later backfill track removes entries as it converts each page, and a stale (now-conforming) entry is itself a checker failure. See docs/okf-frontmatter.md for the field profile.",
      "roots": [
        "docs",
        "idd-template/docs"
      ],
      "reservedFilenames": [
        "index.md",
        "log.md"
      ],
      "types": [
        "index",
        "guide",
        "concept",
        "reference",
        "workflow",
        "design",
        "investigation",
        "tutorial"
      ],
      "exemptPaths": []
    }
  ],
  "markdownLinkAudit": {
    "id": "markdown-link-audit",
    "_comment": "Intra-repo markdown link/anchor audit (#1697): resolves every relative markdown link's target file and #fragment against the target's actual GitHub-slugged headings, preventing the dead-anchor drift class #1696 fixed by hand. Runs unconditionally (not changed-file-scoped), since a heading rename in one file orphans inbound anchors in files a PR never touches. Links from idd-template/** are resolved in template context: a relative link that escapes templateRoot is flagged even when the target happens to exist in the source repo tree, since adopters only receive the idd-template/ subtree. External http(s)/mailto/tel links are out of scope (no network I/O). See audit/README.md for the suppression-comment escape hatch.",
    "globs": [
      "docs/**/*.md",
      "idd-template/**/*.md",
      ".github/instructions/**/*.md",
      "skills/**/*.md",
      "*.md"
    ],
    "templateRoot": "idd-template/"
  }
}
