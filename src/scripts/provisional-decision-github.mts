    return issue;
  }

  async function postComment(
    body: string,
  ): Promise<{ readonly id: string; readonly url: string }> {
    const posted = object(
      JSON.parse(
        ghText(
          [
            'api',
            `${issuePath}/comments`,
            ...hostnameArgs,
            '--method',
            'POST',
            '--input',
            '-',
            '--jq',
            '{id: (.id | tostring), html_url}',
          ],
          { input: JSON.stringify({ body }) },
        ),
      ),
    );
    const id = decimalId(posted.id);
    // Recorded before the read-back, which can throw, so a later lookup in this
    // run still finds the comment this store wrote.
    ownPostIds.add(id);
    return { id, url: text(posted.html_url) };
