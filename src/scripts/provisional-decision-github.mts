type JsonObject = Record<string, unknown>;

function object(value: unknown): JsonObject {
  if (!value || typeof value !== 'object' || Array.isArray(value)) {
    throw new Error('expected a GitHub object');
  }
  return value as JsonObject;
}

function text(value: unknown): string {
  if (typeof value !== 'string') throw new Error('expected a GitHub string');
  return value;
}

function decimalId(value: unknown): string {
  const id = text(value);
  if (!/^(?:0|[1-9][0-9]*)$/.test(id)) {
    throw new Error('expected a decimal-string GitHub comment id');
  }
  return id;
}

function compareIds(left: string, right: string): number {
  return (
    left.length - right.length || (left < right ? -1 : left > right ? 1 : 0)
  );
}

function parseCommentLines(raw: string): {
  rows: JsonObject[];
  complete: boolean;
} {
  const rows: JsonObject[] = [];
  for (const line of raw.split('\n')) {
    if (!line.trim()) continue;
    try {
      rows.push(object(JSON.parse(line)));
    } catch {
      return { rows, complete: false };
    }
  }
  return { rows, complete: true };
}

function requiredChecksPassing(pr: JsonObject, repoPath: string): boolean {
  if (!Array.isArray(pr.statusCheckRollup)) return false;
  try {
    const base = encodeURIComponent(text(pr.baseRefName));
    if (!base) return false;
    const rules = ghApiJson(`${repoPath}/rules/branches/${base}`, {
      paginate: true,
    });
    const protection = object(
      ghApiJson(`${repoPath}/branches/${base}/protection`),
    );
    if (!Array.isArray(rules)) return false;
    const requirements = summarizeBranchReviewRequirements(
      rules as Parameters<typeof summarizeBranchReviewRequirements>[0],
      protection,
    );
    // The rollup has no producer ID with which to verify a pinned requirement.
    if (requirements.requiredCheckSourcePinned) return false;
    return requirements.requiredCheckNames.every((name) => {
      const matches = (pr.statusCheckRollup as unknown[])
        .map(object)
        .filter((check) => (check.name ?? check.context) === name);
      return (
        matches.length > 0 &&
        matches.every((check) =>
          check.__typename === 'CheckRun'
            ? check.status === 'COMPLETED' &&
              check.conclusion === 'SUCCESS' &&
              typeof check.completedAt === 'string' &&
              Number.isFinite(Date.parse(check.completedAt))
            : check.__typename === 'StatusContext' && check.state === 'SUCCESS',
        )
      );
    });
  } catch {
    return false;
  }
}

/** GitHub transport for the command consumer in issue #4799. */
// audit:ignore-dead-export: consumed by the command child #4799
export function createGithubProvisionalDecisionStore(input: {
  readonly repository: string;
  readonly issueNumber: number;
  readonly policy?: IddConfig | null;
}): ProvisionalDecisionStore {
  const { repository, issueNumber } = input;
  if (
    !/^[A-Za-z0-9][A-Za-z0-9-]*\/[A-Za-z0-9_.-]+$/.test(repository) ||
    ['.', '..'].includes(repository.split('/')[1] ?? '') ||
    !Number.isSafeInteger(issueNumber) ||
    issueNumber < 1
  ) {
    throw new Error('invalid provisional-decision repository or issue');
  }
  const repoPath = `repos/${repository}`;
  const issuePath = `${repoPath}/issues/${issueNumber}`;
  const commentsPath = `${issuePath}/comments?per_page=100`;
  const apiHost = resolveGhApiHostname();
  const host = (
    process.env.GH_HOST?.trim() ||
    apiHost ||
    'github.com'
  ).toLowerCase();
  const hostnameArgs = apiHost ? ['--hostname', apiHost] : [];
  const scopedRepository =
    host === 'github.com' ? repository : `${host}/${repository}`;
  const policy = input.policy === undefined ? loadIddConfig() : input.policy;
  const trusted = new Set(
    (Array.isArray(policy?.trustedMarkerActors)
      ? policy.trustedMarkerActors
      : []
    )
      .filter((login): login is string => typeof login === 'string')
      .map((login) => login.toLowerCase()),
  );

  async function readHistory(): Promise<ProvisionalDecisionHistoryRead> {
    const firstPage = ghApiJsonWithHeaders(commentsPath);
    const serverDate = firstPage.headers.date;
    if (!serverDate || !Number.isFinite(Date.parse(serverDate))) {
      throw new Error('comments first page has no usable HTTP Date');
    }
    let raw: string;
    let complete = true;
    try {
      raw = ghText(
        [
          'api',
          commentsPath,
          ...hostnameArgs,
          '--paginate',
          '--jq',
          '.[] | .id |= tostring',
        ],
        {
          timeout: DEFAULT_GH_PAGINATED_TIMEOUT_MS,
          maxBuffer: GH_API_PAGINATED_MAX_BYTES,
          stdio: ['ignore', 'pipe', 'pipe'],
        },
      );
    } catch (error) {
      raw = String((error as { stdout?: unknown } | null)?.stdout ?? '');
      complete = false;
    }
    const parsed = parseCommentLines(raw);
    complete &&= parsed.complete;
    const comments: ProvisionalDecisionHistoryComment[] = [];
    for (let start = 0; start < parsed.rows.length; start += 100) {
      const batch = parsed.rows.slice(start, start + 100);
      try {
        const query = batch
          .map(
            (row, index) =>
              `c${index}: node(id: ${JSON.stringify(text(row.node_id))}) { ... on IssueComment { id lastEditedAt } }`,
          )
          .join('\n');
        const response = object(ghGraphql(`query { ${query} }`, {}));
        if (response.errors !== undefined) complete = false;
        const edits = object(response.data);
        for (const [index, row] of batch.entries()) {
          try {
            const edit = object(edits[`c${index}`]);
            if (
              edit.id !== row.node_id ||
              !('lastEditedAt' in edit) ||
              (edit.lastEditedAt !== null &&
                typeof edit.lastEditedAt !== 'string')
            ) {
              throw new Error('comment edit metadata is missing');
            }
            const authorLogin =
              row.user === null || row.user === undefined
                ? null
                : text(object(row.user).login);
            const createdAt = text(row.created_at);
            if (!Number.isFinite(Date.parse(createdAt))) {
              throw new Error('comment creation timestamp is invalid');
            }
            comments.push({
              id: decimalId(row.id),
              url: text(row.html_url),
              body: text(row.body),
              createdAt,
              authorLogin,
              trustedAuthor:
                authorLogin !== null && trusted.has(authorLogin.toLowerCase()),
              edited: edit.lastEditedAt !== null,
            });
          } catch {
            complete = false;
          }
        }
      } catch {
        complete = false;
      }
    }
    comments.sort(
      (left, right) =>
        Date.parse(left.createdAt) - Date.parse(right.createdAt) ||
        compareIds(left.id, right.id),
    );
    return { comments, complete, serverDate };
  }

  return {
    readHistory,
    async readSourceIssue() {
      const issue = object(ghApiJson(issuePath));
      return {
        title: text(issue.title),
        body: issue.body === null ? '' : text(issue.body),
        updatedAt: text(issue.updated_at),
      };
    },
    async readPullRequest(url) {
      const parsed = new URL(url);
      const match = parsed.pathname.match(
        /^\/([^/]+\/[^/]+)\/pull\/([1-9][0-9]*)$/,
      );
      if (
        parsed.protocol !== 'https:' ||
        parsed.host !== host ||
        parsed.username ||
        parsed.password ||
        parsed.search ||
        parsed.hash ||
        match?.[1].toLowerCase() !== repository.toLowerCase()
      ) {
        throw new Error('pull request URL does not match the store repository');
      }
      const pr = object(
        JSON.parse(
          ghText([
            'pr',
            'view',
            match[2] ?? '',
            '--repo',
            scopedRepository,
            '--json',
            'state,mergedAt,headRefOid,mergeCommit,baseRefName,statusCheckRollup',
          ]),
        ),
      );
      if (!['OPEN', 'CLOSED', 'MERGED'].includes(text(pr.state))) {
        throw new Error('unknown GitHub pull request state');
      }
      return {
        state:
          pr.state === 'MERGED' || pr.mergedAt
            ? 'merged'
            : pr.state === 'OPEN'
              ? 'open'
              : 'closed-unmerged',
        headSha: text(pr.headRefOid),
        mergeCommitSha:
          pr.mergeCommit === null ? null : text(object(pr.mergeCommit).oid),
        requiredChecksPassing: requiredChecksPassing(pr, repoPath),
      };
    },
    async appendRecordBody(recordId, body) {
      const before = await readHistory();
      if (!before.complete)
        throw new Error('cannot append after incomplete history');
      const existing = before.comments.find((comment) => {
        const parsed = parseProvisionalDecisionRecordComment(comment.body);
        return parsed.ok && parsed.record.recordId === recordId;
      });
      if (existing) {
        return {
          result: 'existed',
          record: { id: existing.id, url: existing.url },
        };
      }
      const posted = object(
        JSON.parse(
          ghText(
            [
              'api',
              `${issuePath}/comments`,
              ...hostnameArgs,
              '--method',
              'POST',
              '--input',
              '-',
              '--jq',
              '{id: (.id | tostring), html_url}',
            ],
            { input: JSON.stringify({ body }) },
          ),
        ),
      );
      const id = decimalId(posted.id);
      const url = text(posted.html_url);
      const after = await readHistory();
      if (
        !after.comments.some(
          (comment) => comment.id === id && comment.url === url,
        )
      ) {
        throw new Error('posted record is absent from history read-back');
      }
      return { result: 'created', record: { id, url } };
    },
    async applyOrReadDecisionLabel({ labelName, apply }) {
      if (!labelName.trim() || typeof apply !== 'boolean') {
        throw new Error('invalid decision label request');
      }
      if (apply) {
        // gh parses --add-label as CSV; preserve one exact label name.
        const labelArgument = /[,"\r\n]/.test(labelName)
          ? `"${labelName.replaceAll('"', '""')}"`
          : labelName;
        ghText([
          'issue',
          'edit',
          String(issueNumber),
          '--repo',
          scopedRepository,
          '--add-label',
          labelArgument,
        ]);
      }
      const issue = object(ghApiJson(issuePath));
      if (!Array.isArray(issue.labels))
        throw new Error('issue labels are missing');
      return {
        present: issue.labels.some((label) => object(label).name === labelName),
      };
    },
  };
}
