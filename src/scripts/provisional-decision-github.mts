   * it back. `guard` runs after the history read and before any return or
   * write, so a refusal writes nothing. `beforePost` runs the same way but
   * only when a write follows, so an identical comment that already landed is
   * still returned.
   */
  async function appendOnce(
    write: string,
    matches: (comment: ProvisionalDecisionHistoryComment) => boolean,
    body: string,
    guards: {
      readonly guard?: () => void;
      readonly beforePost?: (history: ProvisionalDecisionHistoryRead) => void;
    } = {},
  ): Promise<{
    readonly result: 'created' | 'existed';
    readonly record: { readonly id: string; readonly url: string };
  }> {
    const before = await readCompleteHistory('append');
    const existing = before.comments.find(
      (comment) => countsAsLanded(comment) && matches(comment),
    );
    guards.guard?.();
    if (existing) {
      return {
        result: 'existed',
        record: { id: existing.id, url: existing.url },
      };
    }
    guards.beforePost?.(before);
    beforeWrite(write);
    const { id, url } = await postComment(body);
    const after = await readHistory();
    // A partial history that happens to hold the comment is not a read-back.
    if (
      !after.complete ||
      !after.comments.some(
        (comment) => comment.id === id && comment.url === url,
      )
    ) {
      throw new Error(
        'posted record is absent from history read-back (or the read-back is incomplete)',
      );
    }
    return { result: 'created', record: { id, url } };
  }

