      }
    },
    async releaseCoordinationClaim(claim) {
      const history = await readCompleteHistory('release the claim');
      const active = readActiveClaimFromHistory(history, { policy });
      if (!sameClaim(active, claim)) {
        throw new Error(
          'cannot release: the coordination claim is not the active claim',
        );
      }
      beforeWrite('claim release');
      const posted = await postComment(
        renderUnclaimedByMarker({
          agentId: claim.agentId,
          claimId: claim.claimId,
          timestamp: isoSecondFromHttpDate(history.serverDate),
        }),
      );
      const after = await readHistory();
      if (
        !after.complete ||
        !after.comments.some(
          (comment) => comment.id === posted.id && comment.url === posted.url,
        )
      ) {
        throw new Error(
          'posted unclaim marker is absent from history read-back (or the read-back is incomplete)',
        );
      }
    },
    async applyOrReadDecisionLabel({ labelName, apply }) {
      if (!labelName.trim() || typeof apply !== 'boolean') {
        throw new Error('invalid decision label request');
      }
      if (apply) {
        // gh parses --add-label as CSV; preserve one exact label name.
        const labelArgument = /[,"\r\n]/.test(labelName)
          ? `"${labelName.replaceAll('"', '""')}"`
          : labelName;
        ghText([
          'issue',
          'edit',
          String(issueNumber),
          '--repo',
          scopedRepository,
          '--add-label',
          labelArgument,
        ]);
      }
      const issue = object(ghApiJson(issuePath));
      if (!Array.isArray(issue.labels))
        throw new Error('issue labels are missing');
      return {
        present: issue.labels.some((label) => object(label).name === labelName),
      };
    },
  };
}
