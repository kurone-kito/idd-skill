/**
 * GitHub transport for the provisional-decision command (issue #4799) and its
 * resolution writes.
 *
 * A lookup of an existing comment (a record, an answer) counts only a comment
 * that is unedited and written by a trusted marker actor, or posted by this
 * store instance. An untrusted comment that pre-posts a deterministic record
 * ID is ignored, so it can neither stand in for the write nor stall the
 * resolution loop, which re-plans a step it cannot see land.
 */
export function createGithubProvisionalDecisionStore(input: {
  readonly repository: string;
  readonly issueNumber: number;
  readonly policy?: IddConfig | null;
  /**
   * The coordination claim a resolution holds. When set, the store is in
   * resolution mode: an answer or record append that would write needs it to
