{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurone-kito.github.io/idd-skill/schemas/provisional-decision.schema.json",
  "title": "Provisional Decision Command Result",
  "description": "Closed result report returned by the provisional-decision command.",
  "type": "object",
  "required": [
    "recordId",
    "commentUrl",
    "state"
  ],
  "properties": {
    "recordId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Record identity produced or recovered by the command, or null when no record exists."
    },
    "commentUrl": {
      "type": "string",
      "description": "URL of the record comment, or an empty string when no comment exists."
    },
    "reason": {
      "type": "string",
      "description": "Reason for refusing the requested transition, when applicable."
    },
    "plan": {
      "type": "object",
      "required": [
        "candidateRecord",
        "verifiedClaimLineage",
        "verifiedAt",
        "locatedDecision",
        "history",
        "baseline",
        "existingRecord",
        "pullRequest"
      ],
      "properties": {
        "candidateRecord": {
          "type": "object",
          "required": [
            "schemaVersion",
            "recordId",
            "source",
            "bundleGeneration",
            "decisionGeneration",
            "claimLineage",
            "evidenceReferences",
            "event"
          ],
          "properties": {
            "schemaVersion": {
              "type": "integer",
              "enum": [
                1
              ],
              "description": "Version of this serialized event contract."
            },
            "recordId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "description": "Stable identity for this immutable event record."
            },
            "source": {
              "type": "object",
              "description": "Repository and issue identity with the source snapshot bound to the decision.",
              "required": [
                "repository",
                "issueNumber",
                "snapshot"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                  "description": "Owner and repository slug whose issue carries the decision."
                },
                "issueNumber": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "Source issue number, bounded to JavaScript's safe-integer range."
                },
                "snapshot": {
                  "type": "object",
                  "description": "The issue title, body digest, and update time captured for this decision.",
                  "required": [
                    "title",
                    "bodySha256",
                    "updatedAt"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Source issue title at the recorded snapshot."
                    },
                    "bodySha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "description": "Lowercase SHA-256 digest of the source issue body."
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "GitHub update time for the source issue snapshot."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "bundleGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Positive generation of the current decision bundle."
            },
            "decisionGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Positive generation of this decision within its bundle."
            },
            "claimLineage": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "claimId",
                  "agentId",
                  "branch",
                  "claimedAt"
                ],
                "properties": {
                  "claimId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Opaque ID of a claim in the source issue's verified lineage."
                  },
                  "agentId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Agent identity recorded for this claim."
                  },
                  "branch": {
                    "type": "string",
                    "pattern": "^issue/[0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Canonical implementation branch for this claim."
                  },
                  "claimedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "GitHub creation time for the claim marker."
                  },
                  "supersedes": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Prior claim ID superseded by this claim, when this is a takeover."
                  }
                },
                "additionalProperties": false
              },
              "description": "Claim identities in lineage order; the replay evaluator verifies them against trusted claim evidence."
            },
            "evidenceReferences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https?://\\S+$",
                "format": "uri"
              },
              "description": "Links to evidence only; a URL does not grant authority or replace independent verification."
            },
            "event": {
              "type": "object",
              "description": "One immutable event in the provisional-decision lifecycle.",
              "oneOf": [
                {
                  "required": [
                    "type",
                    "question",
                    "selectedOption",
                    "feasibleAlternatives",
                    "executionCriteria"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "selected"
                      ],
                      "description": "Marks the event that records a provisional option selection."
                    },
                    "question": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The product, technical, or scope question answered by this decision."
                    },
                    "selectedOption": {
                      "type": "object",
                      "description": "The feasible option selected for provisional execution.",
                      "required": [
                        "id",
                        "description",
                        "feasibilityRationale",
                        "requirementFit",
                        "consequences",
                        "verification",
                        "reversalOrMigration",
                        "rationale"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable ID used to refer to the selected option."
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Human-readable behavior of the selected option."
                        },
                        "feasibilityRationale": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Why the selected option is feasible within the stated constraints."
                        },
                        "requirementFit": {
                          "type": "string",
                          "minLength": 1,
                          "description": "How the selected option meets the source issue's requirements."
                        },
                        "consequences": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Expected consequences of selecting this option."
                        },
                        "verification": {
                          "type": "string",
                          "minLength": 1,
                          "description": "How the selected option's result can be checked."
                        },
                        "reversalOrMigration": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Reversal or migration work required by this option, or why none is required."
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Why the selected option best fits the recorded evidence and requirements."
                        }
                      },
                      "additionalProperties": false
                    },
                    "feasibleAlternatives": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Feasible options compared and rejected in favor of the selected option.",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "description",
                          "feasibilityRationale",
                          "requirementFit",
                          "consequences",
                          "verification",
                          "reversalOrMigration",
                          "comparison",
                          "rejectionReason"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Stable ID used to refer to this alternative."
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Human-readable behavior of this alternative."
                          },
                          "feasibilityRationale": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Why this alternative can be implemented within the stated constraints."
                          },
                          "requirementFit": {
                            "type": "string",
                            "minLength": 1,
                            "description": "How this alternative meets the source issue's requirements."
                          },
                          "consequences": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Expected consequences of choosing this alternative."
                          },
                          "verification": {
                            "type": "string",
                            "minLength": 1,
                            "description": "How this alternative's result could be checked."
                          },
                          "reversalOrMigration": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Reversal or migration work required by this alternative, or why none is required."
                          },
                          "comparison": {
                            "type": "string",
                            "minLength": 1,
                            "description": "How this alternative compares with the selected option."
                          },
                          "rejectionReason": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Why this feasible alternative was not selected."
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "executionCriteria": {
                      "type": "array",
                      "minItems": 1,
                      "description": "Objective conditions that must be met before the provisional work counts as complete.",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "description": "One independently verifiable completion condition."
                      }
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "type",
                    "startedAt",
                    "planReference"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "work-started"
                      ],
                      "description": "Marks the event that binds the decision to ongoing implementation."
                    },
                    "startedAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Time the implementation work was recorded as started."
                    },
                    "planReference": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^https?://\\S+$",
                      "format": "uri",
                      "description": "Link to the reviewed implementation plan for this decision."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "type",
                    "result"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "work-completed"
                      ],
                      "description": "Marks the event that records verified completion evidence."
                    },
                    "result": {
                      "type": "object",
                      "description": "The deliverable and evidence used to verify completed work.",
                      "oneOf": [
                        {
                          "required": [
                            "kind",
                            "reference",
                            "verifiedAt",
                            "headSha",
                            "mergeCommitSha"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "merged-pull-request"
                              ],
                              "description": "Kind of verified deliverable."
                            },
                            "reference": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^https?://\\S+$",
                              "format": "uri",
                              "description": "Link to the deliverable or its authoritative record."
                            },
                            "verifiedAt": {
                              "type": "string",
                              "format": "date-time",
                              "description": "Time the deliverable was independently verified."
                            },
                            "headSha": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{40}$",
                              "description": "Verified pull-request head commit."
                            },
                            "mergeCommitSha": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{40}$",
                              "description": "Verified merge commit."
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "required": [
                            "kind",
                            "reference",
                            "verifiedAt"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "other"
                              ],
                              "description": "Kind of verified deliverable."
                            },
                            "reference": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^https?://\\S+$",
                              "format": "uri",
                              "description": "Link to the deliverable or its authoritative record."
                            },
                            "verifiedAt": {
                              "type": "string",
                              "format": "date-time",
                              "description": "Time the deliverable was independently verified."
                            }
                          },
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "type",
                    "confirmation"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "confirmed"
                      ],
                      "description": "Marks an event that records an explicit human confirmation."
                    },
                    "confirmation": {
                      "type": "object",
                      "description": "Reference and answer for the current completed decision bundle.",
                      "required": [
                        "commentUrl",
                        "response",
                        "confirmedAt"
                      ],
                      "properties": {
                        "commentUrl": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^https?://\\S+$",
                          "format": "uri",
                          "description": "Link to the issue comment carrying the confirmation answer."
                        },
                        "response": {
                          "type": "string",
                          "enum": [
                            "accepted"
                          ],
                          "description": "Affirmative response accepted by the lifecycle."
                        },
                        "confirmedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "GitHub creation time of the confirmation comment."
                        },
                        "confirmedBy": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Display metadata only; replay verifies the actual comment author and does not infer human intent from a shared login."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "type",
                    "reworkRequest"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "rework-requested"
                      ],
                      "description": "Marks an event that records the operator's request to use another option."
                    },
                    "reworkRequest": {
                      "type": "object",
                      "description": "The alternate option and rationale requested for same-source rework.",
                      "required": [
                        "commentUrl",
                        "requestedAt",
                        "requestedOptionId",
                        "rationale"
                      ],
                      "properties": {
                        "commentUrl": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^https?://\\S+$",
                          "format": "uri",
                          "description": "Link to the issue comment that requests the alternate choice."
                        },
                        "requestedAt": {
                          "type": "string",
                          "format": "date-time",
                          "description": "GitHub creation time of the rework request comment."
                        },
                        "requestedOptionId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Stable ID of the alternate option selected by the operator."
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Why the operator requests rework using the alternate option."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "required": [
                    "type",
                    "reworkRoadmap"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "rework-authored"
                      ],
                      "description": "Marks an event that records publication of the same-source rework roadmap."
                    },
                    "reworkRoadmap": {
                      "type": "object",
                      "description": "Identity and link for the authored rework roadmap on the source issue.",
                      "required": [
                        "roadmapIssueNumber",
                        "roadmapMarkerId",
                        "authoringSetId",
                        "url"
                      ],
                      "properties": {
                        "roadmapIssueNumber": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991,
                          "description": "Source issue number after it becomes the rework roadmap."
                        },
                        "roadmapMarkerId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Roadmap identity marker recorded in the source issue body."
                        },
                        "authoringSetId": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Authoring set identity for the held rework children."
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^https?://\\S+$",
                          "format": "uri",
                          "description": "Link to the same issue after it is published as a roadmap."
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false,
          "description": "The provisional decision record that would be appended."
        },
        "verifiedClaimLineage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claimId",
              "agentId",
              "branch",
              "claimedAt"
            ],
            "properties": {
              "claimId": {
                "type": "string",
                "minLength": 1,
                "description": "Unique ID of the verified claim."
              },
              "agentId": {
                "type": "string",
                "minLength": 1,
                "description": "Session-qualified ID of the verified claim owner."
              },
              "branch": {
                "type": "string",
                "pattern": "^issue/[0-9]+-[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Git branch associated with the verified claim."
              },
              "claimedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Time the verified claim was created."
              },
              "supersedes": {
                "type": "string",
                "minLength": 1,
                "description": "Earlier claim ID replaced by this verified claim, when applicable."
              },
              "commentId": {
                "type": "string",
                "minLength": 1,
                "description": "Issue comment ID that records the verified claim."
              }
            },
            "additionalProperties": false
          },
          "description": "Claim lineage independently verified from trusted issue history."
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server time when the evidence in this plan was verified."
        },
        "locatedDecision": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "recordId",
            "bundleGeneration",
            "decisionGeneration",
            "status",
            "bundleState"
          ],
          "properties": {
            "recordId": {
              "type": "string",
              "minLength": 1,
              "description": "Stable identity of the located decision record."
            },
            "bundleGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Generation of the bundle containing the located decision."
            },
            "decisionGeneration": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Generation of the located decision."
            },
            "status": {
              "type": "string",
              "enum": [
                "selected",
                "in-progress",
                "confirmation-pending",
                "confirmed",
                "rework-requested",
                "rework-authored"
              ],
              "description": "Current replayed status of the located decision."
            },
            "bundleState": {
              "type": "string",
              "enum": [
                "accepting",
                "waiting",
                "complete"
              ],
              "description": "Current state of the bundle containing the located decision."
            }
          },
          "additionalProperties": false,
          "description": "Current replayed decision, or null when no valid decision is located."
        },
        "history": {
          "type": "object",
          "required": [
            "comments",
            "complete",
            "serverDate"
          ],
          "properties": {
            "comments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "url",
                  "body",
                  "authorLogin",
                  "createdAt",
                  "edited",
                  "trustedAuthor"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Server-assigned ID of the issue comment."
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "description": "URL of the issue comment."
                  },
                  "body": {
                    "type": "string",
                    "description": "Comment body as read from issue history."
                  },
                  "authorLogin": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "GitHub login of the comment author, or null when unavailable."
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Server creation time of the issue comment."
                  },
                  "edited": {
                    "type": "boolean",
                    "description": "Whether the comment has been edited."
                  },
                  "trustedAuthor": {
                    "type": "boolean",
                    "description": "Whether the author is trusted to provide IDD markers."
                  }
                },
                "additionalProperties": false
              },
              "description": "Issue comments in server order."
            },
            "complete": {
              "type": "boolean",
              "description": "Whether every page of issue history was read successfully."
            },
            "serverDate": {
              "type": "string",
              "minLength": 1,
              "description": "HTTP Date header returned by the issue history read."
            }
          },
          "additionalProperties": false,
          "description": "Complete issue history snapshot used to verify the decision."
        },
        "baseline": {
          "type": "object",
          "required": [
            "title",
            "bodySha256"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Source issue title captured in the baseline."
            },
            "bodySha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 digest of the source issue body captured in the baseline."
            }
          },
          "additionalProperties": false,
          "description": "Source issue baseline compared with the current issue."
        },
        "existingRecord": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "commentId",
            "commentUrl",
            "labelPresent"
          ],
          "properties": {
            "commentId": {
              "type": "string",
              "minLength": 1,
              "description": "Issue comment ID of the existing decision record."
            },
            "commentUrl": {
              "type": "string",
              "minLength": 1,
              "description": "URL of the existing decision record comment."
            },
            "labelPresent": {
              "type": "boolean",
              "description": "Whether the completion label is present on the source issue."
            }
          },
          "additionalProperties": false,
          "description": "Previously stored decision record, or null when none exists."
        },
        "pullRequest": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "state",
            "headSha",
            "mergeCommitSha",
            "requiredChecksPassing"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "open",
                "merged",
                "closed-unmerged"
              ],
              "description": "Current pull request state."
            },
            "headSha": {
              "type": "string",
              "minLength": 1,
              "description": "Commit SHA at the head of the pull request."
            },
            "mergeCommitSha": {
              "type": [
                "string",
                "null"
              ],
              "description": "Merge commit SHA, or null when the pull request is not merged."
            },
            "requiredChecksPassing": {
              "type": "boolean",
              "description": "Whether required checks pass for the pull request."
            }
          },
          "additionalProperties": false,
          "description": "Pull request evidence for completed work, or null when it is not applicable."
        }
      },
      "additionalProperties": false,
      "description": "Evidence and proposed record used to decide whether the transition is safe."
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "applied",
        "reconciled",
        "refused"
      ],
      "description": "Outcome state of the provisional decision command."
    },
    "action": {
      "type": "string",
      "enum": [
        "none",
        "reconcile",
        "recovery-hold",
        "fix-input"
      ],
      "description": "Recovery or follow-up action associated with the outcome, when present."
    }
  },
  "oneOf": [
    {
      "properties": {
        "state": {
          "enum": [
            "planned"
          ]
        },
        "action": {
          "enum": [
            ""
          ]
        }
