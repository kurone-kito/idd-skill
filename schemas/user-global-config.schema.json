              },
              "externalAdvisoryBot": {
                "$ref": "policy.schema.json#/properties/externalAdvisoryBot"
              },
              "maintainerApprovalActorPolicy": {
                "$ref": "policy.schema.json#/properties/maintainerApprovalActorPolicy"
              },
              "maintainerApprovalActors": {
                "$ref": "policy.schema.json#/properties/maintainerApprovalActors"
              },
              "stallRecovery": {
                "$ref": "policy.schema.json#/properties/stallRecovery"
              },
              "forcedHandoff": {
                "$ref": "policy.schema.json#/properties/forcedHandoff"
              },
              "forced-handoff": {
                "$ref": "policy.schema.json#/properties/forced-handoff"
              },
              "forcedHandoffMode": {
                "$ref": "policy.schema.json#/properties/forcedHandoffMode"
              },
              "forced-handoff-mode": {
                "$ref": "policy.schema.json#/properties/forced-handoff-mode"
              },
              "forcedHandoffAuthority": {
                "$ref": "policy.schema.json#/properties/forcedHandoffAuthority"
              },
              "forced-handoff-authority": {
                "$ref": "policy.schema.json#/properties/forced-handoff-authority"
              },
              "markerTrust": {
                "$ref": "policy.schema.json#/properties/markerTrust"
              },
              "markerTrustAllowCollaboratorMarkers": {
                "$ref": "policy.schema.json#/properties/markerTrustAllowCollaboratorMarkers"
              },
              "allowCollaboratorMarkers": {
                "$ref": "policy.schema.json#/properties/allowCollaboratorMarkers"
              },
              "advisoryWait": {
                "$ref": "policy.schema.json#/properties/advisoryWait"
              },
              "advisoryConvergence": {
                "$ref": "policy.schema.json#/properties/advisoryConvergence"
              },
              "ciWait": {
                "$ref": "policy.schema.json#/properties/ciWait"
              },
              "ciGate": {
                "$ref": "policy.schema.json#/properties/ciGate"
              },
              "providerOutage": {
                "$ref": "policy.schema.json#/properties/providerOutage"
              },
              "localValidationEvidence": {
                "$ref": "policy.schema.json#/properties/localValidationEvidence"
              },
              "providerHealth": {
                "$ref": "policy.schema.json#/properties/providerHealth"
              },
              "githubApi": {
                "$ref": "policy.schema.json#/properties/githubApi"
              },
              "discover": {
                "$ref": "policy.schema.json#/properties/discover"
              },
              "claim": {
                "$ref": "policy.schema.json#/properties/claim"
              },
              "critiqueLoop": {
                "$ref": "#/$defs/partialCritiqueLoop",
                "description": "Partial critique-loop settings for user-global policy. Omitted keys inherit from lower layers."
              },
              "reviewEscalation": {
                "$ref": "policy.schema.json#/properties/reviewEscalation"
              },
              "approvalSignals": {
                "$ref": "policy.schema.json#/properties/approvalSignals"
              },
              "issueAuthoring": {
