    },
    "overrides": {
      "type": "array",
      "description": "Repository-specific partial policy entries, evaluated by match specificity.",
      "items": {
        "type": "object",
        "required": [
          "match",
          "config"
        ],
        "properties": {
          "match": {
            "type": "object",
            "description": "Selects one repository by GitHub slug or path suffix, never both.",
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "repo"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^[^/\\s]+/[^/\\s]+$",
                    "description": "GitHub owner/repo slug matched case-insensitively."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?:[^/\\\\]+[/\\\\])*[^/\\\\]+$",
                    "description": "Path suffix matched on whole segments when origin is not GitHub."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "config": {
            "type": "object",
            "description": "Partial policy fields applied above the user-global top-level fields.",
            "properties": {
              "$schema": {
                "$ref": "policy.schema.json#/properties/$schema"
              },
