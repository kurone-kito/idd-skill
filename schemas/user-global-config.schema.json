                "$ref": "policy.schema.json#/properties/orphanFirstPolicy"
              },
              "skipIssueAuthorApprovalGate": {
                "$ref": "policy.schema.json#/properties/skipIssueAuthorApprovalGate"
              },
              "critiqueLoopProfile": {
