  "additionalProperties": false,
  "$defs": {
    "partialClaimTiming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "staleAge": {
          "$ref": "policy.schema.json#/properties/claimTiming/properties/staleAge"
        },
        "heartbeatInterval": {
          "$ref": "policy.schema.json#/properties/claimTiming/properties/heartbeatInterval"
        }
      },
      "description": "Partial claim-ownership timing settings for user-global policy. Omitted fields inherit from lower layers."
