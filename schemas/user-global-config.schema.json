    "overrides": {
      "type": "array",
      "description": "Repository-specific partial policy entries, evaluated by match specificity.",
      "items": {
        "type": "object",
        "required": [
          "match",
          "config"
        ],
        "properties": {
          "match": {
            "type": "object",
            "description": "Selects one repository by GitHub slug or path suffix, never both.",
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "repo"
                ],
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^(?![.]{1,2}/)(?![^/]+/[.]{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                    "description": "GitHub owner/repo slug matched case-insensitively."
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![\\s\\S]*(?:^|[/\\\\])\\.{1,2}(?:[/\\\\]|$))(?:[^/\\\\]+[/\\\\])*[^/\\\\]+$",
                    "description": "Path suffix matched on whole segments when origin is not GitHub. Dot and dot-dot segments are rejected because the resolver cannot match them safely."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "config": {
            "type": "object",
            "description": "Partial policy fields applied above the user-global top-level fields.",
            "properties": {
              "$schema": {
                "$ref": "policy.schema.json#/properties/$schema"
              },
              "iddVersion": {
                "$ref": "policy.schema.json#/properties/iddVersion"
              },
              "markerPrefix": {
                "$ref": "policy.schema.json#/properties/markerPrefix"
              },
              "developmentBranch": {
                "$ref": "policy.schema.json#/properties/developmentBranch"
              },
              "provider": {
                "$ref": "policy.schema.json#/properties/provider"
              },
              "mergePolicy": {
                "$ref": "policy.schema.json#/properties/mergePolicy"
              },
              "mergePolicyAck": {
                "$ref": "policy.schema.json#/properties/mergePolicyAck"
              },
              "reviewPolicy": {
                "$ref": "policy.schema.json#/properties/reviewPolicy"
              },
              "threadResolutionPolicy": {
                "$ref": "policy.schema.json#/properties/threadResolutionPolicy"
              },
              "authoringLanguage": {
                "$ref": "policy.schema.json#/properties/authoringLanguage"
              },
              "claimTiming": {
                "$ref": "#/$defs/partialClaimTiming",
                "description": "Partial claim-ownership timing settings for user-global policy. Omitted fields inherit from lower layers."
              },
              "trustedMarkerActors": {
                "$ref": "policy.schema.json#/properties/trustedMarkerActors"
              },
              "advisoryBotLogins": {
                "$ref": "policy.schema.json#/properties/advisoryBotLogins"
              },
              "workshop": {
                "$ref": "policy.schema.json#/properties/workshop"
              },
              "commands": {
                "$ref": "#/$defs/partialCommands",
                "description": "Partial shell-command overrides for user-global policy. Omitted commands inherit from lower layers."
              },
              "helperRuntime": {
                "$ref": "#/$defs/partialHelperRuntime",
                "description": "Partial helper-runtime selection for user-global policy. Omitted keys inherit from lower layers."
              },
              "issueScope": {
                "$ref": "policy.schema.json#/properties/issueScope"
              },
