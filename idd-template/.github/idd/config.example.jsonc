  // How Discover uses the authored autopilot-suitability score, 1 to 5.
  // "autopilotSuitability": {
  //   // In autopilot runs, issues that score below the floor go to a person:
  //   // 1 admits every score, and 5 admits only a score of 5. An issue with
  //   // no score is evaluated normally, and the safety gates always run.
  //   "floor": 3,
  //   // - true (default): Discover uses the score.
  //   // - false: Discover ignores the score.
  //   "enabled": true,
  //   // Issues whose effort footer is L.
  //   // - "allow" (default): they stay eligible for ready authoring and
  //   //   autopilot Discover.
  //   // - "refuse": they fail the ready-authoring audit unless the body is
  //   //   a roadmap, a bucket audit, or routed to a person, and autopilot
  //   //   Discover routes an effort L orphan candidate to a person, even
  //   //   when enabled is false. Roadmap children are not routed by this
  //   //   policy.
  //   "effortL": "allow"
  // },

  // The disposable-worktree guard.
  // "worktreeGuard": {
  //   // - false (default): idd-doctor only warns about an implementation
  //   //   branch checked out in the primary worktree.
  //   // - true: idd-doctor reports it as an error, and the optional local
  //   //   hook refuses the commit or push once it is wired.
  //   "enabled": false,
  //   // Branch globs that count as implementation branches.
  //   "branchPatterns": ["issue/*", "roadmap-audit/*"],
  //   // - false (default): the guard allows a commit on the base branch in
