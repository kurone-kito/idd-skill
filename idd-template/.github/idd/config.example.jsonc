  // Label names for the IDD roles. Keep every configured label present in
  // the repository.
  // "labels": {
  //   // Applied to roadmap issues; the roadmap-id marker alone identifies a
  //   // roadmap root.
  //   "roadmapLabelName": "roadmap",
  //   // Marks an issue that is blocked on a person; Discover skips it.
  //   "blockedByHumanLabelName": "status:blocked-by-human",
  //   // Marks an issue that needs a maintainer decision; Discover skips it.
  //   "needsDecisionLabelName": "status:needs-decision",
  //   // Marks an issue whose deliverable is other issues; Discover skips it.
  //   "authoringOnlyLabelName": "status:authoring-only",
  //   // Logins of issue auto-labelers that may not apply these labels.
  //   // Default: omitted, which generates no guard workflow. An empty list
  //   // is rejected.
  //   "untrustedLabelerLogins": ["example-labeler[bot]"]
  // },

  // The F3 fallback when the only merge failure is the self-CODEOWNER
  // base-branch policy error.
  // "mergeGate": {
  //   // - "auto-admin-retry" (default): F3 retries once with an admin merge
  //   //   when every gate is green and the author is the only eligible
  //   //   codeowner.
  //   // - "hold-and-report": F3 always holds and reports.
  //   "soloCodeownerAdminFallback": "auto-admin-retry"
  // },

  // Required. Placeholders: replace all four before use. The shell commands
  // for the lifecycle steps; docs/customization.md describes each one. Use
  // true only for a command that is meant to do nothing. This object stays
  // last so that uncommenting any setting above needs no comma change.
  "commands": {
    // Installs the dependencies in a fresh worktree; it must be safe to run
    // again.
    "install-deps": "replace-me: the install-deps command",
    // Fixes and checks the working tree before each commit.
    "fix-validate": "replace-me: the fix-validate command",
    // Checks the branch before a push, without fixing anything.
    "pre-push-validate": "replace-me: the pre-push-validate command",
    // Fixes and fully checks the working tree after review fixes.
    "post-fix-validate": "replace-me: the post-fix-validate command"
  }
}
