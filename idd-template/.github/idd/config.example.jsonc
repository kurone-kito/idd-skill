  //   //   other than developmentBranch. It needs enabled set to true and
  //   //   developmentBranch set.
  //   "refuseBaseBranchCommits": false
  // },

  // Upstream defect escalation, for a repository that imported IDD.
  // "upstreamEscalation": {
  //   // - false (default): no upstream-candidate marker, label, or issue is
  //   //   ever produced.
  //   // - true: a session may record a high-confidence defect in IDD itself
  //   //   as a local status:upstream-candidate issue. It never writes to
  //   //   the IDD source repository.
  //   "enabled": false
