  // Claim verification timing.
  // "claim": {
  //   // How long to wait after posting a claim comment before reading it
  //   // back.
  //   "verifySettleDelay": "PT5S"
  // },

  // Guardrails for the self-review and review-fix loops. A key you leave out
  // keeps its default.
  // "critiqueLoop": {
  //   // After this many C-phase loops, the remaining Low-severity accepted
  //   // findings may be skipped once fix-validate passes.
  //   "cPhaseLowSeveritySkipAfter": 2,
  //   // Consecutive E10 passes without progress before the loop stops: a
  //   // recurring Medium or High finding holds for a maintainer, and Low-only
  //   // findings go to a follow-up issue.
  //   "e10NoProgressHoldAfter": 3,
  //   // The most E10 critique passes per issue. After that, once no High or
  //   // Medium accepted finding is open and fix-validate passes on the
  //   // current head, the remaining Low findings go to a follow-up issue.
  //   "e10MaxPasses": 2,
  //   // From this pull-request-wide Copilot review count, a wording-only Low
  //   // finding that is not adopt-now goes to a follow-up issue instead of
  //   // being fixed.
  //   "deferAfterRounds": 12,
  //   // An urgency-based defer rule that applies from the first round.
  //   // - "off" (default): the rule is off.
  //   // - "low": a Low finding that is not adopt-now goes to a follow-up
  //   //   issue.
  //   // - "low-and-medium": a Low or Medium finding that is not adopt-now
  //   //   goes to a follow-up issue. High never does under low or
  //   //   low-and-medium.
  //   // - "severity-tiered": a severity-and-urgency matrix decides. At step
  //   //   0 (deferRelaxAtRounds left out, or a review count below its first
  //   //   entry), High goes to a follow-up issue only at very-low urgency.
  //   //   See docs/idd-review-policy-profiles.md.
  //   "deferByUrgency": "off",
  //   // Tier and urgency records on review replies made through the
  //   // resolve-review-thread helper.
  //   // - "off" (default): no tier or urgency is required. A reply that
  //   //   passes both still gets a Triage: line.
  //   // - "record": an applied Accepted or Rejected PATH A reply needs a
  //   //   tier and an urgency, which the helper records. A --path-b reply
  //   //   and a maintainer-confirmation reply are exempt.
  //   // - "enforce": like record, and the helper also refuses an Accepted
  //   //   reply that the defer matrix says to defer, unless a reason is
  //   //   given. It acts only with severity-tiered, and otherwise behaves as
  //   //   record.
  //   "triageRecord": "off",
  //   // One or two ascending review counts at which severity-tiered relaxes.
  //   // Default: omitted, which turns the gradient off. No effect under the
  //   // other deferByUrgency values. docs/customization.md recommends the
  //   // example value.
  //   "deferRelaxAtRounds": [4, 7],
  //   // - "on" (default): a finding that needs a person's judgment may go to
  //   //   a needs-decision follow-up issue when merging is safe.
  //   // - "off": the loop stops for a person instead.
  //   "deferNeedsDecision": "on",
  //   // The longest the parent waits for a delegated critique subagent.
  //   "subagentWaitCeiling": "PT20M",
  //   // A command that C1 and E10 run as the critique reviewer.
  //   // Default: omitted, which keeps the per-agent critique; a user-global
  //   // delegate may then apply. Set the key to null to block a user-global
  //   // delegate without adding a command.
  //   "delegate": {
  //     "command": "example-critique-command",
  //     // When the per-agent critique also runs.
  //     // - "fallback" (default): only when the delegate fails.
  //     // - "combined": always, and the findings of both count.
  //     // - "on-success": only when the delegate succeeds, and the findings
  //     //   of both count.
  //     // - "never": never.
  //     "mode": "fallback"
  //   },
  //   // A fire-and-forget command run for each C-phase critique round. It
  //   // never supplies findings or changes the loop. Default: omitted; a
  //   // user-global hook may then apply. Set the key to null to block a
  //   // user-global hook.
  //   "telemetryHook": {
  //     "command": "example-telemetry-command"
  //   }
  // },

  // Timers for a CHANGES_REQUESTED review whose finding was rejected.
  // "reviewEscalation": {
  //   // Reviewer silence after the rejection reply before a maintainer is
  //   // asked.
  //   "changesRequestedFirstEscalation": "PT24H",
  //   // Further silence before the needs-decision label is added and the
  //   // claim is released.
  //   "changesRequestedSecondEscalation": "PT48H"
  // },

  // Approval signals for the issue-author approval gate.
