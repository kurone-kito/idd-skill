#!/bin/sh
# -*- mode: sh -*-
# vim: set ft=sh :

# Fast, commit-safe checks only (biome + dprint + markdownlint). The
# full suite (typecheck, tests, workshop integrity) runs in CI;
# pre-push-validate adds cspell, mirror-drift, code-span-wrap, and
# build:check on top of this hook's checks at push time (post-fix-validate
# adds the same cspell, mirror-drift, and code-span-wrap trio, but not
# build:check). build:check's `git diff` deadlocked here against the
# in-progress commit's index.lock (see #1007).
pnpm run lint:precommit
