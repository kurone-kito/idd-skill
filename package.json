  "scripts": {
    "setup:hooks": "husky",
    "lint": "node src/scripts/check-project.mts lint",
    "lint:minimum": "pnpm run check",
    "lint:fix": "biome check --write --error-on-warnings && dprint fmt \"**/*.md\" && markdownlint-cli2 --fix \"**/*.md\" && markdownlint-cli2 \"**/*.md\" && cspell lint \"**\" --no-progress",
    "lint:precommit": "biome check --error-on-warnings && dprint check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build-ts.mjs",
    "build:check": "node src/scripts/check-build-artifacts.mts && node src/scripts/check-untracked-artifacts.mts",
    "lint:contracts": "node scripts/lint-source-contracts.mjs",
    "lint:boundaries": "node scripts/lint-source-boundaries.mjs",
    "audit:schemas": "node scripts/validate-schemas.mjs",
    "test": "node src/scripts/check-project.mts test",
    "test:scripts": "node --test --import ./tests/isolate-state.mts tests/*.test.mts",
    "fixtures:update": "node scripts/update-fixtures.mjs",
    "docs:sync": "node scripts/sync-docs.mjs --apply",
    "docs:sync:check": "node scripts/sync-docs.mjs --check",
    "check": "node src/scripts/check-project.mts",
    "ci:act": "sh -c 'command -v act >/dev/null 2>&1 || { echo \"ci:act needs act on PATH\" >&2; exit 127; }; CD=$(git rev-parse --path-format=absolute --git-common-dir) || exit 1; GD=$(git rev-parse --absolute-git-dir) || exit 1; UG=$(stat -c %u:%g \"$CD\") || exit 1; [ \"$UG\" = 1000:1000 ] || { echo \"ci:act needs a clone owned by uid 1000, the image node user with a writable HOME\" >&2; exit 1; }; MNT=\"\"; if [ \"$CD\" != \"$GD\" ]; then MNT=\"-v $CD:$CD:ro\"; fi; for PAIR in lint:lint.yml pnpm-boundary:pnpm-boundary.yml pnpm-boundary-node22-floor:pnpm-boundary-node22-floor.yml; do JOB=${PAIR%%:*}; WF=${PAIR#*:}; act pull_request -W \".github/workflows/$WF\" -j \"$JOB\" -P ubuntu-latest=node:24.21.0-trixie --pull=false --action-offline-mode -s GITHUB_TOKEN= --container-daemon-socket - --rm --env RUNNER_TOOL_CACHE=/tmp/hostedtoolcache --container-options \"--init --user $UG $MNT\" || exit $?; done'",
    "audit": "node src/scripts/check-project.mts audit",
    "doctor:github": "node scripts/idd-doctor.mjs --cleanup-backlog-window-days 1"
  },
  "dependencies": {
    "markdown-it": "^14.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@kurone-kito/biome-config": "^0.23.0",
    "@kurone-kito/cspell-config": "^0.23.0",
    "@kurone-kito/markdownlint-config": "^0.23.0",
    "@types/node": "^26.4.1",
    "cspell": "^10.2.2",
    "dprint": "^0.57.1",
    "husky": "^9.1.7",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": "^22.23.2 || ^24.2.0 || >=26.0.0"
  }
